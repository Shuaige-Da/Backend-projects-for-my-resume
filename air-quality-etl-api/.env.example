# Host source directory mounted read-only by Docker Compose.
AQI_HOST_DATA_DIR=D:/data/AQX_P_488_Resource

# Used when running Python directly outside Docker.
AQI_DATA_DIR=D:/data/AQX_P_488_Resource

# Local PostgreSQL / Docker Compose defaults
DB_HOST=localhost
DB_PORT=5432
DB_NAME=air_quality
DB_USER=air_quality
DB_PASSWORD=change_me
WEB_PORT=8080

# Alternatively provide one SQLAlchemy URL and omit the DB_* variables.
# DATABASE_URL=postgresql+psycopg2://air_quality:change_me@localhost:5432/air_quality
